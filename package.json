{
  "name": "chess-learnharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Chess community plugin for LearnHarness: boards, move sequences and interactive chess tasks the teacher can use without drawing anything.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "install:local": "npm run build && node scripts/install-plugin-local.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.13",
    "typescript": "5.9.3"
  }
}
